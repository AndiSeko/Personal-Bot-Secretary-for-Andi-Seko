BOT_TOKEN=your_bot_token_here
OWNER_USERNAME=andi_seko
OWNER_ID=your_telegram_user_id
TIMEZONE=Europe/Moscow
WEB_URL=https://your-domain.com
WEB_PASSWORD=secretary
GROQ_API_KEY=your_groq_api_key_here
AI_MODEL=openai/gpt-oss-20b
DATA_DIR=/data

# --- База данных (выбери один вариант) ---
# 1) SQLite файл (по умолчанию): оставь DATABASE_URL пустым, данные в DATA_DIR/secretary.db
# 2) Postgres (рекомендуется для бесплатных хостов с эфемерной ФС — Render, Koyeb, Northflank):
#    Neon https://neon.tech , Supabase https://supabase.com , Koyeb Postgres — бесплатные тарифы
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# 3) Turso (libSQL) — альтернатива Postgres, если хочешь edge SQLite
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your_token
